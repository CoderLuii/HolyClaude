+
+test('a 4001 websocket close expires the stored session and suppresses reconnect', () => {
+  localStorage.setItem('auth-token', 'stale-token');
+  let expiries = 0;
+  const onExpired = () => {
+    expiries += 1;
+  };
+  window.addEventListener(AUTH_SESSION_EXPIRED_EVENT, onExpired);
+
+  const suppressReconnect = handleAuthenticationRevokedWebSocketClose({ code: 4001 });
+
+  window.removeEventListener(AUTH_SESSION_EXPIRED_EVENT, onExpired);
+  assert.equal(suppressReconnect, true);
+  assert.equal(localStorage.getItem('auth-token'), null);
+  assert.equal(expiries, 1);
+});
+
+test('an ordinary websocket close leaves the session available for reconnect', () => {
+  localStorage.setItem('auth-token', 'live-token');
+
+  assert.equal(handleAuthenticationRevokedWebSocketClose({ code: 1006 }), false);
+  assert.equal(localStorage.getItem('auth-token'), 'live-token');
+});
+
+test('only removal of the auth token is treated as cross-tab session expiry', () => {
+  assert.equal(isAuthTokenRemovalStorageEvent({
+    key: 'auth-token', oldValue: 'stale-token', newValue: null,
+  }), true);
+  assert.equal(isAuthTokenRemovalStorageEvent({
+    key: 'theme', oldValue: 'dark', newValue: null,
+  }), false);
+  assert.equal(isAuthTokenRemovalStorageEvent({
+    key: 'auth-token', oldValue: null, newValue: 'new-token',
+  }), false);
+});
