{
  "$schema": "./product-facts.v1.schema.json",
  "schemaVersion": 1,
  "release": {
    "tag": "v1.5.7",
    "dockerVersion": "1.5.7"
  },
  "registries": {
    "dockerHub": {
      "repository": "coderluii/holyclaude",
      "url": "https://hub.docker.com/r/coderluii/holyclaude"
    },
    "ghcr": {
      "repository": "ghcr.io/coderluii/holyclaude",
      "url": "https://github.com/CoderLuii/HolyClaude/pkgs/container/holyclaude"
    }
  },
  "variants": [
    "full",
    "slim"
  ],
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ],
  "cloudcli": {
    "name": "CloudCLI",
    "command": "cloudcli",
    "version": "1.36.3",
    "variants": [
      "full",
      "slim"
    ]
  },
  "aiClis": [
    {
      "id": "claude-code",
      "name": "Claude Code",
      "command": "claude",
      "version": "2.1.220",
      "variants": [
        "full",
        "slim"
      ]
    },
    {
      "id": "gemini-cli",
      "name": "Gemini CLI",
      "command": "gemini",
      "version": "0.53.0",
      "variants": [
        "full",
        "slim"
      ]
    },
    {
      "id": "openai-codex",
      "name": "OpenAI Codex",
      "command": "codex",
      "version": "0.146.0",
      "variants": [
        "full",
        "slim"
      ]
    },
    {
      "id": "cursor-agent",
      "name": "Cursor Agent",
      "command": "cursor",
      "version": "2026.08.11-e8db854",
      "variants": [
        "full",
        "slim"
      ]
    },
    {
      "id": "taskmaster-ai",
      "name": "TaskMaster AI",
      "command": "task-master",
      "version": "0.43.1",
      "variants": [
        "full",
        "slim"
      ]
    },
    {
      "id": "junie",
      "name": "Junie",
      "command": "junie",
      "version": "2470.4",
      "variants": [
        "full"
      ]
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "command": "opencode",
      "version": "1.18.10",
      "variants": [
        "full"
      ]
    },
    {
      "id": "pi-coding-agent",
      "name": "Pi Coding Agent",
      "command": "pi",
      "version": "0.82.1",
      "variants": [
        "full"
      ]
    }
  ],
  "ports": [
    {
      "id": "cloudcli",
      "label": "CloudCLI web UI",
      "protocol": "tcp",
      "start": 3001,
      "end": 3001,
      "publishedByDefault": true,
      "defaultBinding": "127.0.0.1"
    },
    {
      "id": "codex-auth-callback",
      "label": "Codex authentication callback",
      "protocol": "tcp",
      "start": 1455,
      "end": 1455,
      "publishedByDefault": false,
      "defaultBinding": "127.0.0.1"
    },
    {
      "id": "ssh",
      "label": "Optional SSH",
      "protocol": "tcp",
      "start": 22,
      "end": 22,
      "publishedByDefault": false,
      "defaultBinding": "127.0.0.1"
    },
    {
      "id": "mosh",
      "label": "Optional Mosh UDP range",
      "protocol": "udp",
      "start": 60000,
      "end": 60010,
      "publishedByDefault": false,
      "defaultBinding": "127.0.0.1"
    }
  ],
  "network": {
    "defaultBind": "127.0.0.1",
    "cloudcliUrl": "http://localhost:3001"
  },
  "browser": {
    "chromium": {
      "name": "Debian Chromium",
      "version": "151.0.7922.108",
      "executable": "/usr/bin/chromium"
    },
    "playwright": {
      "version": "1.62.0",
      "browserDownload": false,
      "executable": "/usr/bin/chromium"
    }
  },
  "features": [
    {
      "id": "rootless-podman",
      "enabled": true
    },
    {
      "id": "ssh",
      "enabled": true
    },
    {
      "id": "mosh",
      "enabled": true
    },
    {
      "id": "base-path",
      "enabled": true
    },
    {
      "id": "browser-use",
      "enabled": true
    },
    {
      "id": "account-management",
      "enabled": true
    },
    {
      "id": "project-stats-plugin",
      "enabled": true
    },
    {
      "id": "web-terminal-plugin",
      "enabled": true
    },
    {
      "id": "apprise-notifications",
      "enabled": true
    },
    {
      "id": "multi-arch",
      "enabled": true
    }
  ],
  "notifications": {
    "marker": "~/.claude/notify-on",
    "integrations": [
      "claude-code",
      "codex-cli",
      "gemini-cli",
      "cloudcli-codex"
    ]
  },
  "securityBoundary": {
    "cloudcliAccountModel": "single-user",
    "sharedContext": [
      "workspace",
      "credentials"
    ],
    "remoteSharingCreatesUserIsolation": false
  },
  "licenses": {
    "source": "https://github.com/CoderLuii/HolyClaude/blob/master/LICENSE",
    "thirdPartyNotices": "https://github.com/CoderLuii/HolyClaude/blob/master/THIRD-PARTY-NOTICES"
  },
  "capabilityProfile": {
    "capAdd": [
      "SYS_ADMIN",
      "SYS_PTRACE"
    ],
    "securityOpt": [
      "seccomp=unconfined"
    ],
    "shmSize": "2g"
  }
}
